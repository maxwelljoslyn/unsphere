# Copy to /home/maxwell/unsphere/.env on the server (chmod 700) and fill in.
# settings.py loads it via load_dotenv(BASE_DIR / ".env"). Never commit the real one.
SECRET_KEY=replace-with-a-50+-char-random-value
DEBUG=false
ALLOWED_HOSTS=unsphere.maxwelljoslyn.com
CSRF_TRUSTED_ORIGINS=https://unsphere.maxwelljoslyn.com

# Mailgun SMTP — required so Ryan can register (confirmation email).
# Your superuser bypasses confirmation, so you can log in before this works.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=postmaster@mg.yourdomain.com
EMAIL_HOST_PASSWORD=replace-with-mailgun-smtp-password
DEFAULT_FROM_EMAIL=Unsphere <no-reply@mg.yourdomain.com>

# In-app "Feedback" form -> GitHub issues. Token is a PAT with issue-write
# access to the repo (a deploy key won't work). Issues are filed as the token's
# owner. Leave blank to disable (the form then reports "not configured").
GITHUB_FEEDBACK_REPO=maxwelljoslyn/unsphere
GITHUB_FEEDBACK_TOKEN=replace-with-github-pat

# Sentry error/performance monitoring. Paste the DSN from the unsphere Sentry
# project to enable; leave blank to disable (sentry_sdk.init becomes a no-op).
SENTRY_DSN=
