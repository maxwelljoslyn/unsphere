[Unit]
Description=Unsphere Django App (gunicorn)
After=network.target

[Service]
User=maxwell
Group=maxwell
WorkingDirectory=/home/maxwell/unsphere
# --pythonpath src is the only deviation from zingor: unsphere's apps live under src/.
# Secrets come from /home/maxwell/unsphere/.env, loaded by settings.py (load_dotenv).
ExecStart=/home/maxwell/unsphere/.venv/bin/gunicorn unsphere.wsgi:application --pythonpath src --bind 127.0.0.1:8001 --workers 1 --max-requests 1000 --max-requests-jitter 50
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
